{
  "extends": "@tsconfig/node22/tsconfig.json",
  "include": ["**/*", "../server/**/*"],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.api.tsbuildinfo",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext"],
    "types": ["node", "@vercel/node"],
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["../src/*"]
    }
  }
}
