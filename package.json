{
  "name": "portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "20.x || 22.x || 24.x"
  },
  "scripts": {
    "dev": "vite",
    "dev-host": "npm run dev -- --host",
    "backoffice": "node --watch --watch-path=backoffice backoffice/server.mjs",
    "backoffice:host": "cross-env BACKOFFICE_HOST=0.0.0.0 node --watch --watch-path=backoffice --watch-path=public/content --watch-path=public/images --watch-path=scripts backoffice/server.mjs",
    "build": "npm run generate-og && npm run generate-sitemap && run-p type-check \"build-only {@}\" --",
    "build:ssg": "cross-env VITE_SSG=true vite-ssg build",
    "preview": "vite preview",
    "serve": "node server.js",
    "build-only": "cross-env VITE_SSG=true vite-ssg build",
    "generate-og": "node scripts/generate-og-images.js",
    "generate-sitemap": "node scripts/generate-sitemap.js",
    "optimize-images": "node scripts/optimize-images.js",
    "optimize-images:all": "node scripts/optimize-images.js --all",
    "copy-backoffice": "node scripts/copy-backoffice.js",
    "postbuild": "node scripts/copy-backoffice.js",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix --cache",
    "format": "prettier --write \"**/*.{ts,tsx,js,vue,css,scss,md,json,yml,yaml}\"",
    "prepare": "husky",
    "test": "node --import jiti/register --test server/__tests__/*.test.ts"
  },
  "dependencies": {
    "@fontsource/eb-garamond": "^5.2.7",
    "@octokit/rest": "^22.0.1",
    "@unhead/vue": "^2.1.1",
    "@vee-validate/zod": "^4.15.1",
    "@vercel/node": "^5.10.2",
    "@vueuse/core": "^14.0.0",
    "@vueuse/integrations": "^14.0.0",
    "@vueuse/motion": "^3.0.3",
    "focus-trap": "^7.6.6",
    "gsap": "^3.13.0",
    "jose": "^6.2.9",
    "sharp": "^0.34.5",
    "swiper": "^12.0.3",
    "vee-validate": "^4.15.1",
    "vite-ssg": "^28.2.2",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.18.11",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.37.0",
    "eslint-plugin-vue": "~10.5.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "lint-staged": "^15.5.2",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.6.2",
    "rollup-plugin-visualizer": "^6.0.5",
    "satori": "^0.18.3",
    "satori-html": "^0.3.2",
    "svgo": "^4.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.11",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-vue-devtools": "^8.0.3",
    "vue-tsc": "^3.1.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,vue}": [
      "eslint --fix --cache"
    ],
    "*.{css,scss,md,json,yml,yaml}": [
      "prettier --write"
    ]
  }
}
